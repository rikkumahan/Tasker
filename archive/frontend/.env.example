VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: PageAgent demo. For local demos, you can paste the Groq key in the page
# instead of storing it here. Do not ship a public production build with a real key
# in VITE_PAGE_AGENT_API_KEY because Vite exposes VITE_* values to the browser.
VITE_PAGE_AGENT_BASE_URL=https://api.groq.com/openai/v1
VITE_PAGE_AGENT_MODEL=llama-3.3-70b-versatile
VITE_PAGE_AGENT_API_KEY=
